root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# PowerShell: CRLF, ASCII content only (Windows PowerShell 5.1 compatibility)
[*.{ps1,psm1,psd1}]
end_of_line = crlf

[*.xml]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
